# The canonical origin, no trailing slash. Every absolute URL the build emits -
# canonical, hreflang, Open Graph, JSON-LD @ids, sitemap, robots.txt, llms.txt -
# is derived from this one value.
#
# WARNING: https://multicaravane.com currently answers 308 -> https://www.multicaravane.com.
# With this value, every canonical points at a URL that redirects. Set the apex
# as the primary domain in Vercel (Settings -> Domains) so it serves directly,
# or change this to https://www.multicaravane.com. Nothing else needs editing.
NEXT_PUBLIC_SITE_URL=https://multicaravane.com

# Google Analytics 4 measurement ID.
#
# The tag is injected at runtime only when this is set, so local development and
# preview deployments that leave it empty send no data and load no script. Set it
# in the Vercel project's environment variables for production only.
#
# Vite exposes it because vite.config.js widens envPrefix to accept NEXT_PUBLIC_.
NEXT_PUBLIC_GA_ID=G-59CF299KMJ
