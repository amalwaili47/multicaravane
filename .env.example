# The canonical origin, no trailing slash. Every absolute URL the build emits -
# canonical, hreflang, Open Graph, JSON-LD @ids, sitemap, robots.txt, llms.txt -
# is derived from this one value.
#
# https://multicaravane.com answers 308 -> https://www.multicaravane.com, so www
# is the host that serves and the one to publish. Change this if the Vercel
# primary domain changes; nothing else needs editing.
NEXT_PUBLIC_SITE_URL=https://www.multicaravane.com

# Google Analytics 4 measurement ID, in the form G-XXXXXXXXXX.
#
# The tag is injected at runtime only when this is set, so local development and
# preview deployments that leave it empty send no data and load no script. Set it
# in the Vercel project's environment variables for production only.
#
# Named for the analytics brief; vite.config.js widens envPrefix so Vite exposes
# a NEXT_PUBLIC_-prefixed variable to client code.
NEXT_PUBLIC_GA_ID=
